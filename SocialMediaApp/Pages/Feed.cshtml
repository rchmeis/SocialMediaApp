@page "/feed/{tab?}"
@using SocialMediaAppLibrary.Models
@model SocialMediaApp.Pages.FeedModel

@{
    IFormatProvider danishCulture = new System.Globalization.CultureInfo("da-DK");
}

<style>
    .posts {
        display: flex;
        flex-direction: column;
        gap: 2rem;
        max-width: 40rem;
        margin: 0 auto;
        padding: 1.5rem;
        list-style: none;
    }

    .post {
        display: flex;
        flex-direction: column;
        gap: 1rem;
        border: 1px solid hsl(0 0% 85%);
        border-radius: 0.5rem;

        &:has(.post-link:hover) {
            background: hsl(0 0% 98%);
        }
    }

    .post-link {
        display: flex;
        flex-direction: column;
        gap: 1rem;
        color: unset;
        text-decoration: none;
    }

    .post-header {
        display: grid;
        grid-template-columns: 3rem 1fr;
        grid-template-rows: repeat(2, 1fr);
        gap: 0 0.5rem;
        padding: 1.5rem 1.5rem 0 1.5rem;
    }

    .post-author-profile-picture {
        grid-column: 1 / 2;
        grid-row: 1 / 3;
        width: 3rem;
        height: 3rem;
        border-radius: 50%;
        object-fit: cover;
    }

    .post-author-name {
        grid-column: 2 / 3;
        grid-row: 1 / 2;
        font-weight: 500;
        margin-bottom: 0;

        &::before {
            content: "@@";
        }
    }

    .post-time {
        grid-column: 2 / 3;
        grid-row: 2 / 3;
        font-size: 0.875rem;
        font-weight: 500;
        color: hsl(0 0% 33%);
    }

    .post-body {
        display: flex;
        flex-direction: column;
        gap: 0.5rem;
        padding: 0 1.5rem;
    }

    .post-title {
        font-size: 1.5rem;
        font-weight: 700;
        margin-bottom: 0;
    }

    .post-content {
        white-space: pre-wrap;
        margin-bottom: 0;
    }

    .post-image-gallery {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        grid-template-rows: repeat(2, 1fr);
        gap: 0.25rem;
        aspect-ratio: 4 / 3;
        padding: 0 1.5rem;

        &:has(> :only-child) {
            grid-template-columns: 1fr;
            grid-template-rows: 1fr;
        }

        &:has(> :nth-child(2):last-child) {
            grid-template-rows: 1fr;
        }

        &:has(> :nth-child(3):last-child) {
            grid-template-columns: repeat(2, 1fr);
            grid-template-rows: repeat(2, 1fr);

            > :first-child {
                grid-row: 1 / 3;
            }

            > :last-child {
                grid-column: 2 / 3;
            }
        }

        &:has(> :nth-child(4):last-child) {
            grid-template-columns: repeat(2, 1fr);
            grid-template-rows: repeat(2, 1fr);
        }
    }

    .post-image-card {
        display: grid;
        padding: 0;
        border: none;
        border-radius: 0.25rem;
        overflow: hidden;
        background: transparent;
        cursor: pointer;
    }

    .post-image-card img {
        display: block;
        height: 100%;
        width: 100%;
        aspect-ratio: 4 / 3;
        object-fit: cover;
        transition: transform .35s ease, filter .35s ease;
    }

    .post-image-card:hover img {
        transform: scale(1.06);
        filter: brightness(.85);
    }

    .lightbox {
        position: fixed;
        inset: 0;
        margin: auto;
        padding: 0;
        width: min(90vw, 75rem);
        max-width: none;
        max-height: 90vh;
        border: none;
        overflow: visible;
        background: transparent;
        color: hsl(0 0% 100%);
    }

    .lightbox::backdrop {
        background: hsl(0 0% 0% / 0.9);
        backdrop-filter: blur(8px);
    }

    .modal-content {
        position: relative;
        display: flex;
        align-items: center;
        justify-content: center;
        min-height: 20rem;
    }

    .modal-content img {
        display: block;
        max-width: 100%;
        max-height: 80vh;
        object-fit: contain;
        border-radius: 10px;
    }

    .modal-nav {
        position: absolute;
        top: 50%;
        z-index: 2;
        transform: translateY(-50%);
        display: grid;
        place-items: center;
        width: 3rem;
        height: 3rem;
        border: none;
        border-radius: 50%;
        color: hsl(0 0% 100%);
        background: hsl(0 0% 0% / 0.25);
        font-size: 1.5rem;
        cursor: pointer;
    }

    .modal-nav.prev {
        left: 0.75rem;
    }

    .modal-nav.next {
        right: 0.75rem;
    }

    .image-caption {
        position: absolute;
        bottom: -2rem;
        width: 100%;
        margin: 0;
        color: hsl(0 0% 90%);
        text-align: center;
        font-size: 0.875rem;
    }

    .post-footer {
        display: flex;
        flex-direction: row;
        gap: 1rem;
        padding: 0 1.5rem 1.5rem 1.5rem;
        font-size: 0.875rem;
        font-weight: 500;
        color: hsl(0 0% 33%);
    }

    .feed-pagination {
        display: flex;
        justify-content: center;
        align-items: center;
        gap: 1rem;
        margin: 1rem 0;
    }

    .pagination-button {
        padding: 0.25rem 0.5rem;
        background-color: hsl(0 0% 8%);
        color: hsl(0, 0%, 96%);
        text-decoration: none;
        user-select: none;
    }

    span.pagination-button {
        background-color: hsl(0 0% 96%);
        color: hsl(0, 0%, 75%);
    }
</style>

<ul class="posts">
    @foreach (Post post in Model.Posts.Items)
    {
    <li>
        <article class="post" id="post-@post.Id">
            <a class="post-link" asp-page="/Posts/PostDetails" asp-route-postId="@post.Id">
                <div class="post-header">
                    <img
                        class="post-author-profile-picture"
                        src="@(post.Author.ProfileImage != null
                            ? $"/images/{post.Author.ProfileImage.Id}/{post.Author.ProfileImage.FileName}"
                            : Url.Content("~/images/default-avatar.jpg"))"
                        alt="@post.Author.DisplayName"
                    />
                    <p class="post-author-name">@post.Author.DisplayName</p>
                    <div class="post-time">
                        <time
                            datetime="@post.CreatedAt.ToString("yyyy-MM-ddTHH:mm")"
                            title="@post.CreatedAt.ToString("d. MMMM yyyy, HH:mm", danishCulture)"
                        >
                            @post.TimeAgo()
                        </time>
                        @if (post.UpdatedAt.HasValue)
                        {
                        <span title="@post.UpdatedAt.Value.ToString("d. MMMM yyyy, HH:mm", danishCulture)" class="post-edited">
                            (Redigeret)
                        </span>
                        }
                    </div>
                </div>

                <div class="post-body">
                    @if (post.Title != null)
                    {
                    <p class="post-title">@post.Title</p>
                    }

                    <p class="post-content">@post.Content</p>
                </div>
            </a>

            @if (post.Images.Count > 0)
            {
            <div class="post-gallery-container">
                <div class="post-image-gallery" id="post-image-gallery-@post.Id">
                    @for (int i = 0; i < post.Images.Count; i++)
                    {

                    Image image = post.Images[i];

                    <button
                        type="button"
                        class="post-image-card"
                        data-index="@i"
                        data-dialog="image-dialog-@post.Id">

                        <img src="/images/@image.Id/@image.FileName" alt="@image.AltText" loading="lazy" />
                    </button>
                    }
                </div>

                <dialog id="image-dialog-@post.Id" class="lightbox">
                    <div class="modal-content">
                        <button type="button" class="modal-nav prev modal-prev">&#10094;</button>
                        <img class="modal-image" src="" alt="" />
                        <button type="button" class="modal-nav next modal-next">&#10095;</button>
                        <p class="image-caption"></p>
                    </div>
                </dialog>
            </div>
            }

            @* TODO: Add functionality for liking and commenting on posts *@
            <div class="post-footer">
                <p>@post.LikesCount like@(post.LikesCount != 1 ? "s" : "")</p>
                <p>@post.Comments.Count kommentar@(post.Comments.Count != 1 ? "er" : "")</p>
            </div>
        </article>
    </li>
    }
</ul>

@* `href` is used instead of `asp-page` because we need explicit control over the URL, as `page` as a query parameter is a reserved keyword in Razor Pages *@
<nav class="feed-pagination">
    @if (Model.PageNumber > 1)
    {
    <a class="pagination-button" href="@Model.GetPageUrl(Model.PageNumber - 1)">&#10094;</a>
    }
    else
    {
    <span class="pagination-button">&#10094;</span>
    }
    <span>Side @Model.PageNumber</span>
    @if (Model.Posts.HasMore)
    {
    <a class="pagination-button" href="@Model.GetPageUrl(Model.PageNumber + 1)">&#10095;</a>
    }
    else
    {
    <span class="pagination-button">&#10095;</span>
    }
</nav>