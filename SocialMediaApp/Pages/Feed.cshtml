@page "/feed/{tab?}"
@using SocialMediaAppLibrary.Models
@model SocialMediaApp.Pages.FeedModel

@{
    IFormatProvider danishCulture = new System.Globalization.CultureInfo("da-DK");
}

<style>
    :root {
        scroll-behavior: auto !important; /* Override bootstrap scroll behavior */
    }

    .section {
        display: flex;
        flex-direction: column;
        align-items: center;
        margin: 0 auto;
    }

    .tab-navigation {
        display: flex;
        justify-content: center;
        margin-bottom: 1rem;
    }

    .tab-list {
        display: flex;
        gap: 1rem;
        list-style: none;
        padding: 0;
        margin: 0;
    }

    .tab-link {
        display: inline-block;
        padding: 0.5rem 1rem;
        text-decoration: none;
        color: hsl(0 0% 0%);

        &.active {
            font-weight: 500;
            border-bottom: 2px solid hsl(0 0% 0%);
        }
    }

    .posts {
        display: flex;
        flex-direction: column;
        gap: 2rem;
        max-width: 40rem;
        margin: 0 auto;
        padding: 1.5rem;
        list-style: none;
    }

    .post {
        display: flex;
        flex-direction: column;
        border: 1px solid hsl(0 0% 85%);
        border-radius: 0.5rem;

        &:has(.post-link:hover) {
            background: hsl(0 0% 98%);
        }
    }

    .post-header {
        display: grid;
        grid-template-columns: 3rem 1fr;
        grid-template-rows: repeat(2, 1fr);
        gap: 0 0.5rem;
        padding: 1.5rem 1.5rem 0.75rem 1.5rem;
        color: unset;
        text-decoration: none;
    }

    .post-author-profile-picture {
        grid-column: 1 / 2;
        grid-row: 1 / 3;
        width: 3rem;
        height: 3rem;
        border-radius: 50%;
        object-fit: cover;
    }

    .post-author-name {
        grid-column: 2 / 3;
        grid-row: 1 / 2;
        font-weight: 500;
        margin-bottom: 0;

        &::before {
            content: "@@";
        }
    }

    .post-time {
        grid-column: 2 / 3;
        grid-row: 2 / 3;
        font-size: 0.875rem;
        font-weight: 500;
        color: hsl(0 0% 33%);
    }

    .post-body {
        display: flex;
        flex-direction: column;
        gap: 0.5rem;
        padding: 0.75rem 1.5rem;
        color: unset;
        text-decoration: none;
    }

    .post-title {
        font-size: 1.5rem;
        font-weight: 700;
        margin-bottom: 0;
    }

    .post-content {
        white-space: pre-wrap;
        margin-bottom: 0;
    }

    .post-image-gallery {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        grid-template-rows: repeat(2, 1fr);
        gap: 0.25rem;

        &:has(> :only-child) {
            grid-template-columns: 1fr;
            grid-template-rows: 1fr;
        }

        &:has(> :nth-child(2):last-child) {
            grid-template-rows: 1fr;
        }

        &:has(> :nth-child(3):last-child) {
            aspect-ratio: 4 / 3;
            grid-template-columns: repeat(2, 1fr);
            grid-template-rows: repeat(2, 1fr);

            > :first-child {
                grid-row: 1 / 3;
            }

            > :last-child {
                grid-column: 2 / 3;
            }
        }

        &:has(> :nth-child(4):last-child) {
            aspect-ratio: 4 / 3;
            grid-template-columns: repeat(2, 1fr);
            grid-template-rows: repeat(2, 1fr);
        }
    }

    .post-image-card {
        display: grid;
        padding: 0;
        border: none;
        border-radius: 0.25rem;
        overflow: hidden;
        background: transparent;
        cursor: pointer;
    }

    .post-image-card img {
        display: block;
        height: 100%;
        width: 100%;
        object-fit: cover;
        transition: transform .35s ease, filter .35s ease;
    }

    .post-image-card:hover img {
        transform: scale(1.06);
        filter: brightness(.85);
    }

    .lightbox {
        position: fixed;
        inset: 0;
        margin: auto;
        padding: 0;
        width: min(90vw, 75rem);
        max-width: none;
        max-height: 90vh;
        border: none;
        overflow: visible;
        background: transparent;
        color: hsl(0 0% 100%);
    }

    .lightbox::backdrop {
        background: hsl(0 0% 0% / 0.9);
        backdrop-filter: blur(8px);
    }

    .modal-content {
        position: relative;
        display: flex;
        align-items: center;
        justify-content: center;
        min-height: 20rem;
    }

    .modal-content img {
        display: block;
        max-width: 100%;
        max-height: 80vh;
        object-fit: contain;
        border-radius: 10px;
    }

    .modal-nav {
        position: absolute;
        top: 50%;
        z-index: 2;
        transform: translateY(-50%);
        display: grid;
        place-items: center;
        width: 3rem;
        height: 3rem;
        border: none;
        border-radius: 50%;
        color: hsl(0 0% 100%);
        background: hsl(0 0% 0% / 0.25);
        font-size: 1.5rem;
        cursor: pointer;
    }

    .modal-nav.prev {
        left: 0.75rem;
    }

    .modal-nav.next {
        right: 0.75rem;
    }

    .image-caption {
        position: absolute;
        bottom: -2rem;
        width: 100%;
        margin: 0;
        color: hsl(0 0% 90%);
        text-align: center;
        font-size: 0.875rem;
    }

    .post-footer {
        display: flex;
        flex-direction: row;
        align-items: center;
        gap: 1rem;
        padding: 0.75rem 1.5rem 1.5rem 1.5rem;
        font-size: 0.875rem;
        font-weight: 500;
        color: hsl(0 0% 33%);

        p {
            margin: 0;
        }
    }

    .post-likes {
        display: flex;
        flex-direction: row;
        gap: 0.5rem;
        align-items: center;
    }

    .post-likes-actions > button {
        border: none;
        padding: 0.75rem;
        cursor: pointer;
        background-color: var(--heart-color);
        mask: var(--heart-icon) no-repeat center / contain;
    }

    .post-likes-actions > button.solid-heart {
        --heart-color: hsl(0 95% 55%);
        --heart-icon: url("/images/solid-heart.svg");
    }

    .post-likes-actions > button.outline-heart {
        --heart-color: hsl(0 0% 0%);
        --heart-icon: url("/images/outline-heart.svg");
    }

    .post-likes-actions > button.solid-heart:hover {
        --heart-color: hsl(0 0% 0%);
        --heart-icon: url("/images/outline-heart.svg");
    }

    .post-likes-actions > button.outline-heart:hover {
        --heart-color: hsl(0 95% 55%);
        --heart-icon: url("/images/solid-heart.svg");
    }

    .feed-pagination {
        display: flex;
        justify-content: center;
        align-items: center;
        gap: 1rem;
        margin: 1rem 0;
    }

    .pagination-button {
        padding: 0.25rem 0.5rem;
        background-color: hsl(0 0% 8%);
        color: hsl(0, 0%, 96%);
        text-decoration: none;
        user-select: none;
    }

    span.pagination-button {
        background-color: hsl(0 0% 96%);
        color: hsl(0, 0%, 75%);
    }
</style>

<section class="section">
    <nav class="tab-navigation">
        <ul class="tab-list">
            @foreach (KeyValuePair<FeedTab, string> tab in Model.FeedTabs)
            {
            <li>
                <a class="tab-link @(Model.CurrentTab == tab.Key.ToString().ToLower() ? "active" : "")"
                    asp-page="/Feed"
                    asp-route-tab="@tab.Key.ToString().ToLower()">
                    @tab.Value
                </a>
            </li>
            }
        </ul>
    </nav>

    <!-- [ÆNDRING] MIDLERTIDIGT Link til oprettelse af opslag fra det generelle feed med returnUrl -->
    <div class="feed-create-post">
        <a class="create-post-link"
        asp-page="/Posts/CreatePost"
        asp-route-returnUrl="@Url.Page("/Feed", new { tab = Model.CurrentTab })">
            Opret opslag
        </a>
    </div>

    <ul class="posts">
        @foreach (Post post in Model.Posts.Items)
        {
        <li>
            <article class="post" id="post-@post.Id">
                <a class="post-header" asp-page="/Account/Profile/Index" asp-route-id="@post.Author.Id">
                    @* Tilføjet: link til forfatterens profil med route-id *@
                    <img
                        class="post-author-profile-picture"
                        src="@(post.Author.ProfileImage != null
                            ? $"/images/{post.Author.ProfileImage.Id}/{post.Author.ProfileImage.FileName}"
                            : Url.Content("~/images/default-avatar.jpg"))"
                        alt="@post.Author.DisplayName"
                    />
                    <p class="post-author-name">@post.Author.DisplayName</p>

                    <div class="post-time">
                        <time
                            datetime="@post.CreatedAt.ToString("yyyy-MM-ddTHH:mm")"
                            title="@post.CreatedAt.ToString("d. MMMM yyyy, HH:mm", danishCulture)"
                        >
                            @post.TimeAgo()
                        </time>
                        @if (post.UpdatedAt.HasValue)
                        {
                        <span title="@post.UpdatedAt.Value.ToString("d. MMMM yyyy, HH:mm", danishCulture)" class="post-edited">
                            (Redigeret)
                        </span>
                        }
                    </div>
                    @* Tilføjet: lukker forfatter-linket *@
                </a> 
            
                <a class="post-body" asp-page="/Posts/PostDetails" asp-route-postId="@post.Id">
                    @if (post.Title != null)
                    {
                    <p class="post-title">@post.Title</p>
                    }

                    <p class="post-content">@post.Content</p>
                    @if (post.Images.Count > 0)
                    {
                    <div class="post-gallery-container">
                        <div class="post-image-gallery" id="post-image-gallery-@post.Id">
                            @for (int i = 0; i < post.Images.Count; i++)
                            {

                            Image image = post.Images[i];

                            <button
                                type="button"
                                class="post-image-card"
                                data-index="@i"
                                data-dialog="image-dialog-@post.Id">

                                <img src="/images/@image.Id/@image.FileName" alt="@image.AltText" loading="lazy" />
                            </button>
                            }
                        </div>

                        <dialog id="image-dialog-@post.Id" class="lightbox">
                            <div class="modal-content">
                                <button type="button" class="modal-nav prev modal-prev">&#10094;</button>
                                <img class="modal-image" src="" alt="" />
                                <button type="button" class="modal-nav next modal-next">&#10095;</button>
                                <p class="image-caption"></p>
                            </div>
                        </dialog>
                    </div>
                    }
                </a> 


                @* TODO: Add functionality for liking and commenting on posts *@
                <div class="post-footer">
                    <div class="post-likes">
                        <form method="post" class="post-likes-actions">
                            <input type="hidden" name="postId" value="@post.Id" />
                            <input type="hidden" name="tab" value="@Model.CurrentTab" />
                            <input type="hidden" name="pageNumber" value="@Model.PageNumber" />
                            @if (Model.LikedPostIds.Contains(post.Id))
                            {
                            <button class="solid-heart" type="submit" asp-page-handler="Unlike"></button>
                            }
                            else
                            {
                            <button class="outline-heart" type="submit" asp-page-handler="Like"></button>
                            }
                        </form>
                        <p>@post.LikesCount like@(post.LikesCount != 1 ? "s" : "")</p>
                    </div>
                    <p>@post.Comments.Count kommentar@(post.Comments.Count != 1 ? "er" : "")</p>
                </div>
            </article>
        </li>
        }
    </ul>

    @* `href` is used instead of `asp-page` because we need explicit control over the URL, as `page` as a query parameter is a reserved keyword in Razor Pages *@
    <nav class="feed-pagination">
        @if (Model.PageNumber > 1)
        {
        <a class="pagination-button" href="@Model.GetPageUrl(Model.PageNumber - 1)">&#10094;</a>
        }
        else
        {
        <span class="pagination-button">&#10094;</span>
        }
        <span>Side @Model.PageNumber</span>
        @if (Model.Posts.HasMore)
        {
        <a class="pagination-button" href="@Model.GetPageUrl(Model.PageNumber + 1)">&#10095;</a>
        }
        else
        {
        <span class="pagination-button">&#10095;</span>
        }
    </nav>
</section>