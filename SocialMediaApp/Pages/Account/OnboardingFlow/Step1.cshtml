@page
@using SocialMediaAppLibrary.Models
@model SocialMediaApp.Pages.Account.OnboardingFlow.Step1Model
@{
}

<div class="container">
    <h1>Onboarding: Trin 1/3</h1>
    <h2>Velkommen til StudentHub, @Model.userAuth.Username</h2>
    
    
    <!-- Interests and bio form-->
    <form method="post">
        
        <div>
            <label asp-for="inputBio">Skriv en kort bio eller dit yndlingscitat</label>
            <input asp-for="inputBio" type="text"></input>
        </div>
        
        @foreach (Interest interest in @Model.allInterests)
        {
            <div>
                <label asp-for="inputInterests">@interest.Name</label>
                <input asp-for="inputInterests" type="checkbox"></input>
            </div>   
        }
    </form>
</div>
<!--write a short bio or favorite quote-->
