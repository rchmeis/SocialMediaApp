@page
@model SocialMediaApp.Pages.Account.OnboardingFlow.Step2Model
@using SocialMediaAppLibrary.Models
@{    
    ViewData["Title"] = "Profilbillede - Trin 2";
}

@if (Model.PreviewImage.Id >0)
{
    <hr />
    <h1>Forhåndsvisning</h1>
    <picture>
        @if (Model.PreviewImage.Id > 0)
        {
            <img class="avatar-round"
                src="/images/@Model.PreviewImage.Id/@Model.PreviewImage.FileName"
                 alt="@(Model.PreviewImage.AltText ?? "Profilbillede")"
                 width="@Model.PreviewImage.Width"
                 height="@Model.PreviewImage.Height" />
        }
        else if (Model.PreviewImage.ImageData is { Length: > 0 })
        {
            var base64 = Convert.ToBase64String(Model.PreviewImage.ImageData);
            <img class="avatar-round" src="data:image/webp;base64,@base64"
                 alt="@(Model.PreviewImage.AltText ?? "Profilbillede")"
                 width="@Model.PreviewImage.Width"
                 height="@Model.PreviewImage.Height" />
        }
    </picture>
}
else{
    <img class="avatar-round" src="/images/default-avatar.jpg" alt="standard profilbilldee" />
}


<form method="post" enctype="multipart/form-data">
    <div asp-validation-summary="All"></div>

    <div class="upload-row">
        <label asp-for="UploadedImage" class="btn-upload">
            @(Model.PreviewImage is not null ? "Skift billede" : "Vælg billede")
        </label>
        <input asp-for="UploadedImage"
               type="file"
               accept=".jpg, .jpeg, .png, .webp"
               class="hidden-file-input" />
        <span asp-validation-for="UploadedImage"></span>
    </div>

    <div class="action-row">
        <button asp-page-handler="Upload" type="submit" class="btn-secondary">Preview</button>
        @if (Model.PreviewImage is not null)
        {
            <button asp-page-handler="Save" type="submit" class="btn-save">Gem og næste</button>
        }
    </div>
</form>


<style>

    .avatar-round {
        width: 150px;
        height: 150px;
        border-radius: 50%;
        object-fit: cover;
        display: block;
    }

    .hidden-file-input {
        position: absolute;
        width: 1px;
        height: 1px;
        padding: 0;
        margin: -1px;
        overflow: hidden;
        clip-path: inset(50%);
        white-space: nowrap;
        border: 0;
    }

    .upload-row,
    .action-row {
        margin-top: 12px;
    }

    .btn-upload,
    .btn-secondary,
    .btn-save {
        display: inline-block;
        padding: 8px 16px;
        border: none;
        border-radius: 6px;
        font-size: 1rem;
        font-weight: 500;
        cursor: pointer;
    }

    .btn-upload,
    .btn-secondary {
        background-color: #e2e8f0;
        color: #0f172a;
    }

        .btn-upload:hover,
        .btn-secondary:hover {
            background-color: #cbd5e1;
        }

    .btn-save {
        background-color: #2563eb;
        color: #ffffff;
    }

        .btn-save:hover {
            background-color: #1d4ed8;
        }
</style>