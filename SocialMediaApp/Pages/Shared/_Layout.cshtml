@using System.Security.Claims

<!-- Properties for reusability -->
@{
    var isLoggedIn = User.Identity?.IsAuthenticated == true;
    var currentPath = Context.Request.Path.Value?.ToLower() ?? ""; // Getting page path and put it into a string

    // Used to highlight the active tab in the sidebar
    bool IsActive(string prefix) => currentPath.StartsWith(prefix);
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] – StudentHub</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/layout.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/SocialMediaApp.styles.css" asp-append-version="true" />
    <script defer type="module" src="~/js/createPost.js"></script>
    <script defer type="module" src="~/js/postGalleryCarousel.js"></script>
</head>
<body>

    <!-- Header bar -->
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-white border-bottom box-shadow">
            <div class="container">
                <a class="navbar-brand" asp-area="" asp-page="/Index">StudentHub</a>
                <div>
                    <ul class="navbar-nav align-items-center ms-auto">
                        @if (User.Identity != null && User.Identity.IsAuthenticated)
                        {
                            // 1. Retrieve data directly from cookie claims
                            var displayName = User.FindFirst(ClaimTypes.Name)?.Value ?? User.Identity.Name;
                            var imageId = User.FindFirst("ImageId")?.Value;
                            var imageFileName = User.FindFirst("ImageFileName")?.Value;

                            // 2. WHEN USER IS LOGGED IN (Show image, name, and dropdown menu)
                            <li class="nav-item">
                                <details class="profile-menu">
                                    <summary>
                                        @if (!string.IsNullOrEmpty(imageId))
                                        {
                                            <!-- Calls our handler that fetches byte[] from the database -->
                                            <img src="/images/@imageId/@imageFileName" alt="Profilmenu" />
                                        }
                                        else
                                        {
                                            <img src="~/images/default-avatar.jpg" alt="Profilmenu" />
                                        }
                                    </summary>

                                    <div class="profile-menu-list">
                                        <span class="profile-menu-name">@displayName</span>
                                        <a asp-page="/Account/Profile/Index">Se profil</a>
                                        <a asp-page="/Account/Inbox/Index">Indbakke</a>
                                        <a asp-page="/Account/Profile/EditProfile">Rediger profil</a>
                                        <form method="post" asp-page="/Account/SignOut">
                                            <button type="submit">Log ud</button>
                                        </form>
                                    </div>
                                </details>
                            </li>
                        }
                        else
                        {
                            // 3. WHEN USER IS LOGGED OUT (Show login and signup buttons)
                            <li class="nav-item">
                                <a class="btn btn-primary btn-sm" asp-page="/Account/SignIn">Login</a>
                                <a class="btn btn-secondary btn-sm" asp-page="/Account/Signupflow/step1">Opret Bruger</a>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    @* render page *@
    <div class="flash-banner-stack">
        @if (Context.Request.Query["accessDenied"] == "true")
        {
            <div class="flash-banner flash-banner--warning" role="alert">
                <span><strong>Advarsel:</strong> Du har ikke tilladelse til at udføre denne handling eller tilgå den side.</span>
                <button type="button" class="flash-banner__close" aria-label="Luk" onclick="this.parentElement.remove()">&#215;</button>
            </div>
        }

        @if (TempData["Success"] is string success)
        {
            <div class="flash-banner flash-banner--success" role="alert">
                <span>@success</span>
                <button type="button" class="flash-banner__close" aria-label="Luk" onclick="this.parentElement.remove()">&#215;</button>
            </div>
        }

        @if (TempData["Error"] is string error)
        {
            <div class="flash-banner flash-banner--error" role="alert">
                <span>@error</span>
                <button type="button" class="flash-banner__close" aria-label="Luk" onclick="this.parentElement.remove()">&#215;</button>
            </div>
        }
    </div>

    <div class="app-body">

        <!-- Sidebar -->
        @if (isLoggedIn)
        {
            <div class="sidebar">
                <nav aria-label="Hovednavigation">
                    <ul class="sidebar-nav">
                        <li>
                            @if (IsActive("/feed"))
                            {
                                <a asp-page="/Feed" class="sidebar-link active" aria-current="page">
                                    <span>Feed / Nyheder</span>
                                </a>
                            }
                            else
                            {
                                <a asp-page="/Feed" class="sidebar-link">
                                    <span>Feed / Nyheder</span>
                                </a>
                            }
                        </li>

                        <li>
                            @if (IsActive("/events"))
                            {
                                <a asp-page="/Events/Index" class="sidebar-link active" aria-current="page">
                                    <span>Events / Offline Meets</span>
                                </a>
                            }
                            else
                            {
                                <a asp-page="/Events/Index" class="sidebar-link">
                                    <span>Events / Offline Meets</span>
                                </a>
                            }
                        </li>

                        <li>
                            @if (IsActive("/marketplace"))
                            {
                                <a asp-page="/MarketPlace/Index" class="sidebar-link active" aria-current="page">
                                    <span>Bytte / Salg</span>
                                </a>
                            }
                            else
                            {
                                <a asp-page="/MarketPlace/Index" class="sidebar-link">
                                    <span>Bytte / Salg</span>
                                </a>
                            }
                        </li>

                        <li>
                            @if (IsActive("/studentjobs"))
                            {
                                <a asp-page="/StudentJobs/Index" class="sidebar-link active" aria-current="page">
                                    <span>Studiejobs</span>
                                </a>
                            }
                            else
                            {
                                <a asp-page="/StudentJobs/Index" class="sidebar-link">
                                    <span>Studiejobs</span>
                                </a>
                            }
                        </li>

                        <li>
                            @if (IsActive("/account/profile/connections"))
                            {
                                <a asp-page="/Account/Profile/Connections" class="sidebar-link active" aria-current="page">
                                    <span>Mit Netværk</span>
                                </a>
                            }
                            else
                            {
                                <a asp-page="/Account/Profile/Connections" class="sidebar-link">
                                    <span>Mit Netværk</span>
                                </a>
                            }
                        </li>
                    </ul>
                </nav>

                <!-- "+ Opret" i bunden -->
                <div class="dropup sidebar-create-wrapper">
                    <button class="sidebar-create" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                        <i class="bi bi-plus-lg" aria-hidden="true"></i>
                        <span>Opret</span>
                    </button>
                    <ul class="dropdown-menu w-100">
                        <li><a class="dropdown-item" href="#">Opret opslag</a></li>
                        <li><a class="dropdown-item" href="#">Opret event</a></li>
                    </ul>
                </div>
            </div>
        }

        <!-- Render Page FLYTTET OP så de ikke viser sig lodret -->
@*         <main role="main" class="app-body">
            @if (Context.Request.Query["accessDenied"] == "true")
            {
                <div class="alert alert-warning alert-dismissible fade show rounded-0 mb-0 text-center" role="alert">
                    <strong>Advarsel:</strong> Du har ikke tilladelse til at udføre denne handling eller tilgå den side.
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }

            @if (TempData["Success"] is string success)
            {
                <div class="success-div" role="alert">
                    @success
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Luk"></button>
                </div>
            }

            @if (TempData["Error"] is string error)
            {
                <div class="error-div" role="alert">
                    @error
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Luk"></button>
                </div>
            } *@

            @RenderBody()
        </main>
    </div>

    <footer class="app-footer">
        © 2026 StudentHub · <a asp-area="" asp-page="/Privacy">Privatlivspolitik</a>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>