@page "/post/{postId:int}"
@using SocialMediaAppLibrary.Models
@model SocialMediaApp.Pages.Posts.PostDetailsModel
@{
    IFormatProvider danishCulture = new System.Globalization.CultureInfo("da-DK");
}

<style>
    .post {
        display: flex;
        flex-direction: column;
        gap: 1rem;
        max-width: 40rem;
        margin: 0 auto;
        padding: 1.5rem;
    }

    .post-header {
        display: grid;
        grid-template-columns: 3rem 1fr;
        grid-template-rows: repeat(2, 1fr);
        gap: 0 0.5rem;
    }

    .post-author-profile-picture {
        grid-column: 1 / 2;
        grid-row: 1 / 3;
        width: 3rem;
        height: 3rem;
        border-radius: 50%;
        object-fit: cover;
    }

    .post-author-name {
        grid-column: 2 / 3;
        grid-row: 1 / 2;
        font-weight: 500;
        margin-bottom: 0;

        &::before {
            content: "@@";
        }
    }

    .post-time {
        grid-column: 2 / 3;
        grid-row: 2 / 3;
        font-size: 0.875rem;
        font-weight: 500;
        color: hsl(0 0% 33%);
    }

    .post-body {
        display: flex;
        flex-direction: column;
        gap: 0.5rem;
    }

    .post-title {
        font-size: 1.5rem;
        font-weight: 700;
        margin-bottom: 0;
    }

    .post-content {
        white-space: pre-wrap;
        margin-bottom: 0;
    }

    .modal-nav {
        display: grid;
        place-items: center;
        width: 3rem;
        height: 3rem;
        border: none;
        border-radius: 50%;
        color: hsl(0 0% 100%);
        background: hsl(0 0% 0% / 0.25);
        font-size: 1.5rem;
    }

    .post-image-gallery {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        grid-template-rows: repeat(2, 1fr);
        gap: 0.25rem;
        flex-wrap: nowrap;
        aspect-ratio: 4 / 3;

        &:has(> :only-child) {
            grid-template-columns: 1fr;
            grid-template-rows: 1fr;
        }

        &:has(> :nth-child(2):last-child) {
            grid-template-rows: 1fr;
        }

        &:has(> :nth-child(3):last-child) {
            grid-template-columns: repeat(2, 1fr);
            grid-template-rows: repeat(2, 1fr);

            > :first-child {
                grid-row: 1 / 3;
            }

            > :last-child {
                grid-column: 2 / 3;
            }
        }

        &:has(> :nth-child(4):last-child) {
            grid-template-columns: repeat(2, 1fr);
            grid-template-rows: repeat(2, 1fr);
        }
    }

    .post-image-card {
        display: grid;
        padding: 0;
        border: none;
        border-radius: 0.25rem;
        overflow: hidden;
        background: transparent;
    }

    .post-image-card img {
        display: block;
        height: 100%;
        width: 100%;
        aspect-ratio: 4 / 3;
        object-fit: cover;
        transition: transform .35s ease, filter .35s ease;
    }

    .post-image-card:hover img {
        transform: scale(1.06);
        filter: brightness(.85);
    }

    .lightbox {
        position: fixed;
        inset: 0;
        margin: auto;
        padding: 0;
        width: min(90vw, 75rem);
        max-width: none;
        max-height: 90vh;
        border: none;
        overflow: visible;
        background: transparent;
        color: hsl(0 0% 100%);
    }

    .lightbox::backdrop {
        background: hsl(0 0% 0% / 0.9);
        backdrop-filter: blur(8px);
    }

    .modal-content {
        position: relative;
        display: flex;
        align-items: center;
        justify-content: center;
        min-height: 20rem;
    }

    .modal-content img {
        display: block;
        max-width: 100%;
        max-height: 80vh;
        object-fit: contain;
        border-radius: 10px;
    }

    .modal-nav {
        position: absolute;
        top: 50%;
        z-index: 2;
        transform: translateY(-50%);
    }

    .modal-nav.prev {
        left: 0.75rem;
    }

    .modal-nav.next {
        right: 0.75rem;
    }

    #image-caption {
        position: absolute;
        bottom: -2rem;
        width: 100%;
        margin: 0;
        color: hsl(0 0% 90%);
        text-align: center;
        font-size: 0.875rem;
    }

    .post-footer {
        display: flex;
        flex-direction: row;
        gap: 1rem;
        font-size: 0.875rem;
        font-weight: 500;
        color: hsl(0 0% 33%);
    }
</style>

<article class="post" id="post-@Model.PostDetails.Id">
    <div class="post-header">
        <img
            class="post-author-profile-picture"
            src="@(Model.PostDetails.Author.ProfileImage != null
                ? $"/images/{Model.PostDetails.Author.ProfileImage.Id}/{Model.PostDetails.Author.ProfileImage.FileName}"
                : Url.Content("~/images/default-avatar.jpg"))"
            alt="@Model.PostDetails.Author.DisplayName"
        />
        <p class="post-author-name">@(Model.PostDetails.Author.DisplayName)</p>
        <div class="post-time">
            <time
                datetime="@Model.PostDetails.CreatedAt.ToString("yyyy-MM-ddTHH:mm")"
                title="@Model.PostDetails.CreatedAt.ToString("d. MMMM yyyy, HH:mm", danishCulture)"
            >
                @Model.PostDetails.TimeAgo()
            </time>
            @if (Model.PostDetails.UpdatedAt.HasValue)
            {
            <span title="@Model.PostDetails.UpdatedAt.Value.ToString("d. MMMM yyyy, HH:mm", danishCulture)" class="post-edited">
                (Redigeret)
            </span>
            }
        </div>
    </div>

    <div class="post-body">
        @if (Model.PostDetails.Title != null)
        {
        <p class="post-title">@Model.PostDetails.Title</p>
        }

        <p class="post-content">@Model.PostDetails.Content</p>
    </div>

    @* Only render the image gallery if the post has images to display *@
    @if (Model.PostDetails.Images.Count > 0)
    {
    <div class="post-gallery-container">
        <div class="post-image-gallery" id="post-image-gallery-@Model.PostDetails.Id">
            @for (int i = 0; i < Model.PostDetails.Images.Count; i++)
            {

            Image image = Model.PostDetails.Images[i];

            <button type="button" class="post-image-card" data-index="@i">
                <img src="/images/@image.Id/@image.FileName" alt="@image.AltText" loading="lazy" />
            </button>
            }
        </div>

        <dialog id="image-dialog" class="lightbox">
            <div class="modal-content">
                <button type="button" class="modal-nav prev modal-prev">&#10094;</button>
                <img class="modal-image" src="" alt="" />
                <button type="button" class="modal-nav next modal-next">&#10095;</button>
                <p class="image-caption"></p>
            </div>
        </dialog>
    </div>
    }

    @* TODO: Add functionality for liking and commenting on posts *@
    <div class="post-footer">
        <p>@Model.PostDetails.LikesCount like@(Model.PostDetails.LikesCount != 1 ? "s" : "")</p>
        <p>@Model.PostDetails.Comments.Count kommentar@(Model.PostDetails.Comments.Count != 1 ? "er" : "")</p>
    </div>
</article>
