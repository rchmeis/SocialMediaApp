@page "/post/{postId:int}"
@using SocialMediaAppLibrary.Models
@using SocialMediaApp.Security;
@model SocialMediaApp.Pages.Posts.PostDetailsModel
@{
    IFormatProvider danishCulture = new System.Globalization.CultureInfo("da-DK");
}

<style>
    .post {
        display: flex;
        flex-direction: column;
        max-width: 40rem;
        margin: 0 auto;
    }

    .post-header {
        display: grid;
        grid-template-columns: 3rem 1fr;
        grid-template-rows: repeat(2, 1fr);
        gap: 0 0.5rem;
        padding: 1.5rem 1.5rem 0.75rem 1.5rem;
        color: unset;
        text-decoration: none;
    }

    .post-author-profile-picture {
        grid-column: 1 / 2;
        grid-row: 1 / 3;
        width: 3rem;
        height: 3rem;
        border-radius: 50%;
        object-fit: cover;
    }

    .post-author-name {
        grid-column: 2 / 3;
        grid-row: 1 / 2;
        font-weight: 500;
        margin-bottom: 0;

        &::before {
            content: "@@";
        }
    }

    .post-time {
        grid-column: 2 / 3;
        grid-row: 2 / 3;
        font-size: 0.875rem;
        font-weight: 500;
        color: hsl(0 0% 33%);
    }

    .post-body {
        display: flex;
        flex-direction: column;
        gap: 0.5rem;
        padding: 0.75rem 1.5rem;
    }

    .post-title {
        font-size: 1.5rem;
        font-weight: 700;
        margin-bottom: 0;
    }

    .post-content {
        white-space: pre-wrap;
        margin-bottom: 0;
    }

    .modal-nav {
        display: grid;
        place-items: center;
        width: 3rem;
        height: 3rem;
        border: none;
        border-radius: 50%;
        color: hsl(0 0% 100%);
        background: hsl(0 0% 0% / 0.25);
        font-size: 1.5rem;
    }

    .post-image-gallery {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        grid-template-rows: repeat(2, 1fr);
        gap: 0.25rem;
        margin-top: 0.75rem;

        &:has(> :only-child) {
            grid-template-columns: 1fr;
            grid-template-rows: 1fr;
        }

        &:has(> :nth-child(2):last-child) {
            grid-template-rows: 1fr;
        }

        &:has(> :nth-child(3):last-child) {
            aspect-ratio: 4 / 3;
            grid-template-columns: repeat(2, 1fr);
            grid-template-rows: repeat(2, 1fr);

            > :first-child {
                grid-row: 1 / 3;
            }

            > :last-child {
                grid-column: 2 / 3;
            }
        }

        &:has(> :nth-child(4):last-child) {
            aspect-ratio: 4 / 3;
            grid-template-columns: repeat(2, 1fr);
            grid-template-rows: repeat(2, 1fr);
        }
    }

    .post-image-card {
        display: grid;
        padding: 0;
        border: none;
        border-radius: 0.25rem;
        overflow: hidden;
        background: transparent;
    }

    .post-image-card img {
        display: block;
        height: 100%;
        width: 100%;
        object-fit: cover;
        transition: transform .35s ease, filter .35s ease;
    }

    .post-image-card:hover img {
        transform: scale(1.06);
        filter: brightness(.85);
    }

    .lightbox {
        position: fixed;
        inset: 0;
        margin: auto;
        padding: 0;
        width: min(90vw, 75rem);
        max-width: none;
        max-height: 90vh;
        border: none;
        overflow: visible;
        background: transparent;
        color: hsl(0 0% 100%);
    }

    .lightbox::backdrop {
        background: hsl(0 0% 0% / 0.9);
        backdrop-filter: blur(8px);
    }

    .modal-content {
        position: relative;
        display: flex;
        align-items: center;
        justify-content: center;
        min-height: 20rem;
    }

    .modal-content img {
        display: block;
        max-width: 100%;
        max-height: 80vh;
        object-fit: contain;
        border-radius: 10px;
    }

    .modal-nav {
        position: absolute;
        top: 50%;
        z-index: 2;
        transform: translateY(-50%);
    }

    .modal-nav.prev {
        left: 0.75rem;
    }

    .modal-nav.next {
        right: 0.75rem;
    }

    #image-caption {
        position: absolute;
        bottom: -2rem;
        width: 100%;
        margin: 0;
        color: hsl(0 0% 90%);
        text-align: center;
        font-size: 0.875rem;
    }

    .post-footer {
        display: flex;
        flex-direction: row;
        align-items: center;
        gap: 1rem;
        font-size: 0.875rem;
        font-weight: 500;
        color: hsl(0 0% 33%);
        padding: 0.75rem 1.5rem 1.5rem 1.5rem;

        p {
            margin: 0;
        }
    }

    .post-likes {
        display: flex;
        flex-direction: row;
        gap: 0.5rem;
        align-items: center;
    }

    .post-likes-actions > button {
        border: none;
        padding: 0.75rem;
        cursor: pointer;
        background-color: var(--heart-color);
        mask: var(--heart-icon) no-repeat center / contain;
    }

    .post-likes-actions > button.solid-heart {
        --heart-color: hsl(0 95% 55%);
        --heart-icon: url("/images/solid-heart.svg");
    }

    .post-likes-actions > button.outline-heart {
        --heart-color: hsl(0 0% 0%);
        --heart-icon: url("/images/outline-heart.svg");
    }

    .post-likes-actions > button.solid-heart:hover {
        --heart-color: hsl(0 0% 0%);
        --heart-icon: url("/images/outline-heart.svg");
    }

    .post-likes-actions > button.outline-heart:hover {
        --heart-color: hsl(0 95% 55%);
        --heart-icon: url("/images/solid-heart.svg");
    }
</style>


<article class="post" id="post-@Model.PostDetails.Id">
    <a class="post-header" asp-page="/Account/Profile/Index" asp-route-id="@Model.PostDetails.Author.Id">
        <img
            class="post-author-profile-picture"
            src="@(Model.PostDetails.Author.ProfileImage != null
                ? $"/images/{Model.PostDetails.Author.ProfileImage.Id}/{Model.PostDetails.Author.ProfileImage.FileName}"
                : Url.Content("~/images/default-avatar.jpg"))"
            alt="@Model.PostDetails.Author.DisplayName"
        />
        <p class="post-author-name">@(Model.PostDetails.Author.DisplayName)</p>
        </a>

        <a class="post-link" asp-page="/Posts/PostDetails" asp-route-postId="@Model.PostDetails.Id" asp-route-returnUrl="@Url.Page("/Feed")">
        <div class="post-time">
            <time
                datetime="@Model.PostDetails.CreatedAt.ToString("yyyy-MM-ddTHH:mm")"
                title="@Model.PostDetails.CreatedAt.ToString("d. MMMM yyyy, HH:mm", danishCulture)"
            >
                @Model.PostDetails.TimeAgo()
            </time>
            @if (Model.PostDetails.UpdatedAt.HasValue)
            {
            <span title="@Model.PostDetails.UpdatedAt.Value.ToString("d. MMMM yyyy, HH:mm", danishCulture)" class="post-edited">
                (Redigeret)
            </span>
            }
        </div>
    </a>

    <a class="post-link" asp-page="/Posts/PostDetails" asp-route-postId="@Model.PostDetails.Id">
    <div class="post-body">
        @if (Model.PostDetails.Title != null)
        {
        <p class="post-title">@Model.PostDetails.Title</p>
        }

        <p class="post-content">@Model.PostDetails.Content</p>

        @* Only render the image gallery if the post has images to display *@
        @if (Model.PostDetails.Images.Count > 0)
        {
        <div class="post-gallery-container">
            <div class="post-image-gallery" id="post-image-gallery-@Model.PostDetails.Id">
                @for (int i = 0; i < Model.PostDetails.Images.Count; i++)
                {

                Image image = Model.PostDetails.Images[i];

                <button type="button" class="post-image-card" data-index="@i">
                    <img src="/images/@image.Id/@image.FileName" alt="@image.AltText" loading="lazy" />
                </button>
                }
            </div>

            <dialog id="image-dialog" class="lightbox">
                <div class="modal-content">
                    <button type="button" class="modal-nav prev modal-prev">&#10094;</button>
                    <img class="modal-image" src="" alt="" />
                    <button type="button" class="modal-nav next modal-next">&#10095;</button>
                    <p class="image-caption"></p>
                </div>
            </dialog>
        </div>
        }
    </div>

        <dialog id="image-dialog" class="lightbox">
            <div class="modal-content">
                <button type="button" class="modal-nav prev modal-prev">&#10094;</button>
                <img class="modal-image" src="" alt="" />
                <button type="button" class="modal-nav next modal-next">&#10095;</button>
                <p class="image-caption"></p>
            </div>
        </dialog>
    </div>
    }

    @* funcitonality for deleting/editing posts *@

    @if (Model.PostDetails.Author != null && Model.PostDetails.Author.Id == Model.LoggedInUserId)
    {
        <details class="post-menu">
            <summary class="post-menu-trigger" aria-label="Flere valgmuligheder for opslag">&#8943;</summary>
            <div class="post-menu-dropdown">
                <a class="post-menu-item"
                   asp-page="/Posts/UpdatePost"
                   asp-route-postId="@Model.PostDetails.Id"
                   asp-route-returnUrl="@Model.SafeReturnUrl">
                    Rediger
                </a>

                <div class="delete-confirm-wrapper">
                    <input type="checkbox"
                           id="confirm-delete-@Model.PostDetails.Id"
                           class="delete-confirm-toggle"
                           aria-hidden="true" />

                    <label for="confirm-delete-@Model.PostDetails.Id"
                           class="post-menu-item post-menu-item--danger">
                        Slet
                    </label>

                    <div class="delete-modal-backdrop" role="dialog" aria-modal="true" aria-labelledby="delete-title-@Model.PostDetails.Id">
                        <div class="delete-modal-box">
                            <h3 id="delete-title-@Model.PostDetails.Id" class="delete-modal-title">Slet opslag?</h3>
                            <p class="delete-modal-text">
                                Er du sikker på, at du vil slette dette opslag? Handlingen kan ikke fortrydes.
                            </p>

                            <div class="delete-modal-actions">
                                <label for="confirm-delete-@Model.PostDetails.Id" class="delete-btn delete-btn--cancel">
                                    Annuller
                                </label>

                                <form method="post"
                                      asp-page="/Account/Profile/Index"
                                      asp-page-handler="DeletePost"
                                      asp-route-postId="@Model.PostDetails.Id"
                                      asp-route-returnUrl="@Model.SafeReturnUrl"
                                      class="delete-confirm-form">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="delete-btn delete-btn--confirm">
                                        Bekræft
                                    </button>
                                </form>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </details>
    }


    @* TODO: Add functionality for liking and commenting on posts *@
    <div class="post-footer">
        <div class="post-likes">
            <form method="post" class="post-likes-actions">
            @if (Model.IsLiked)
            {
                <button class="solid-heart" type="submit" asp-page-handler="Unlike"></button>
            }
            else
            {
                <button class="outline-heart" type="submit" asp-page-handler="Like"></button>
            }
            </form>
            <p>@Model.PostDetails.LikesCount like@(Model.PostDetails.LikesCount != 1 ? "s" : "")</p>
        </div>
        <p>@Model.PostDetails.Comments.Count kommentar@(Model.PostDetails.Comments.Count != 1 ? "er" : "")</p>
    </div>
    
</article>
