@page "/post/{postId:int}"
@model SocialMediaApp.Pages.Posts.PostDetailsModel
@{
}

<style>
    .post {
        display: flex;
        flex-direction: column;
        gap: 0.5rem;
        max-width: 40rem;
        margin: 0 auto;
        padding: 1.5rem;
    }

    .post-header {
        display: grid;
        grid-template-columns: 3rem 1fr;
        grid-template-rows: repeat(2, 1fr);
        gap: 0 0.5rem;
    }

    .post-author-profile-picture {
        grid-column: 1 / 2;
        grid-row: 1 / 3;
        width: 3rem;
        height: 3rem;
        border-radius: 50%;
        object-fit: cover;
    }

    .post-author-name {
        grid-column: 2 / 3;
        grid-row: 1 / 2;
        font-weight: 500;
        margin-bottom: 0;

        &::before {
            content: "@@";
        }
    }

    .post-time {
        grid-column: 2 / 3;
        grid-row: 2 / 3;
        font-size: 0.875rem;
        font-weight: 500;
        color: hsl(0 0% 33%);
    }

    .post-title {
        font-size: 1.5rem;
        font-weight: 700;
        margin-bottom: 0;
    }

    .post-content {
        white-space: pre-wrap;
    }
</style>

<article class="post">
    <div class="post-header">
        <img
            class="post-author-profile-picture"
            src="@(Model.PostDetails.Author.ProfileImage != null
                ? $"/Index?handler=UserImage&id={Model.PostDetails.Author.ProfileImage.Id}"
                : Url.Content("~/images/default-avatar.jpg"))"
            alt="@Model.PostDetails.Author.DisplayName"
        />
        <p class="post-author-name">@(Model.PostDetails.Author.DisplayName)</p>
        <div class="post-time">
            <time
                datetime="@Model.PostDetails.CreatedAt.ToString("yyyy-MM-ddTHH:mm")"
                title="@Model.PostDetails.CreatedAt.ToString("d. MMMM yyyy, HH:mm", new System.Globalization.CultureInfo("da-DK"))"
            >
                @Model.PostDetails.TimeAgo()
            </time>
            @if (Model.PostDetails.UpdatedAt.HasValue)
            {
            <span title="@Model.PostDetails.UpdatedAt.Value.ToString("d. MMMM yyyy, HH:mm", new System.Globalization.CultureInfo("da-DK"))" class="post-edited">
                (Redigeret)
            </span>
            }
        </div>
    </div>

    @if (Model.PostDetails.Title != null)
    {
    <p class="post-title">@Model.PostDetails.Title</p>
    }
    <p class="post-content">@Model.PostDetails.Content</p>
</article>
